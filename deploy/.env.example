# EduAgent 本机单环境（local）变量样例 —— 复制为 deploy/.env 后按需修改
# 用法：cp .env.example .env && docker compose up -d
#
# 当前部署形态（方案 B）：
#   - Docker 只跑基础设施（mysql / nacos / redis / rabbitmq / chroma / ai），端口暴露到 localhost。
#   - 6 个 Java 服务本机 IDE 直跑，注册进同一 Nacos 命名空间 edu-agent-local。
# 因此本文件只覆盖「基础设施容器的启动参数」；Java 服务的环境变量各在
# application.yml 默认 localhost，一般无需设置。

# 统一单环境（已被各服务 application.yml 设为默认值，无需改动）
SPRING_PROFILES_ACTIVE=local
NACOS_NAMESPACE=edu-agent-local
NACOS_GROUP=edu-agent
NACOS_GROUP_RESOURCE=resource-group

# Nacos 控制台（standalone 默认关闭鉴权，便于 push-nacos-config.py 直推）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# MySQL（init-microservice.sql 挂载初始化，自动建 5 库 + 账号）
MYSQL_ROOT_PASSWORD=edu_agent_root
DB_USER=edu_agent
DB_PASSWORD=edu_agent

# RabbitMQ
MQ_USER=edu_agent
MQ_PASSWORD=edu_agent

# JWT：全网（含网关验签）必须共享同一份；多台联调机器保持一致
JWT_SECRET=edu-agent-local-secret-please-change

# 首次启动为 auth 服务的 admin 账户设置的口令
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin123
