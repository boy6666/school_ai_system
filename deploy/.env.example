# EduAgent 联调环境（Linux）变量样例 —— 复制为 deploy/.env 后按需修改
# 用法：cp .env.example .env && docker compose --env-file .env up -d
#
# 容器间通信用 compose 内部服务名（nacos / mysql / rabbitmq / chroma / ai / gateway / web），
# 以下仅用于“秘密 / 开关 / 外部可达地址”。服务内部的 NACOS_ADDR/DB_HOST 等已在
# compose 里固定为内部服务名，无需在此设置。

# 默认 profile：core。可叠加：
#   --profile skywalking   启用 APM（elasticsearch + oap + ui）
#   --profile web          启用前端（zzy 8.15 后交付）
SPRING_PROFILES_ACTIVE=formal
NACOS_NAMESPACE=edu-agent-formal
NACOS_GROUP=edu-agent
NACOS_GROUP_RESOURCE=resource-group

# Nacos 控制台（默认关闭鉴权，便于 push-nacos-config.py 直推；生产建议开启）
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# MySQL（init-microservice.sql 已建 5 库 + edu_agent 账号）
MYSQL_ROOT_PASSWORD=edu_agent_root
DB_USER=edu_agent
DB_PASSWORD=edu_agent

# RabbitMQ
MQ_USER=edu_agent
MQ_PASSWORD=edu_agent

# JWT（Linux 联调务必替换为强随机值）
JWT_SECRET=please-change-to-a-long-random-secret

# SkyWalking（仅 --profile skywalking 时生效）
SW_STORAGE_ES_CLUSTER_NODES=http://elasticsearch:9200
