<?xml version="1.0"?>
<ruleset name="EduAgent Teaching Ruleset"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <!--
      教学级 PMD 规则子集（dev-wuyoucheng §2.4.3）：Best Practices / Code Style / Design。
      priority &lt;= 3 记为违规，每条违规 -3（下限 -20）。
      若规则引用在升级中失效，StaticCheckService 会防御性降级（记录日志，不阻断判分）。
    -->
    <description>EduAgent 教学判分 PMD 规则集</description>

    <rule ref="category/java/bestpractices.xml/EmptyCatchBlock"/>
    <rule ref="category/java/codestyle.xml/UnnecessaryImport"/>
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="reportLevel" value="15"/>
        </properties>
    </rule>
    <rule ref="category/java/errorprone.xml/CloseResource"/>
</ruleset>
