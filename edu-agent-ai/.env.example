# 遗留样例：键名与 school_agent/config.py 不一致，代码里也没有 mock 分支，勿照抄。
# 实际读取的键见下方「真实键名」段（或 README「快速运行」）。

# ⚠️ 以下三项无效（历史键名）
USE_MOCK_LLM=1
MODEL_NAME=星火API测试体验
BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
API_KEY=

# ══════════ 真实键名（config.py 读这些） ══════════
# 没有 API_KEY 时不会走 mock：call_llm 返回 "LLM 调用失败: …" 文本并原样回带。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LOG_LEVEL=INFO

# Nacos（服务发现 + 配置中心；配置中心的值会覆盖这里的同名变量）
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=edu-agent-local
NACOS_GROUP=edu-agent
NACOS_ENABLE=1

TEMPERATURE=0
MAX_TOKENS=1024
MAX_KB_CHARS=1800
