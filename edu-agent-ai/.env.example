# 复制为 .env 后填入你的 Key
# 兼容 OpenAI 的接口均可：chat/completions + Bearer 鉴权。

# 接入腾讯云 tokenhub（示例模型 deepseek-v4-flash）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tokenhub.tencentmaas.com/v1
LLM_MODEL=deepseek-v4-flash

# 参数名须与 school_agent/config.py 一致（LLM_ 前缀）
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
MAX_KB_CHARS=1800

# 数据目录
DATA_DIR=data
KNOWLEDGE_BASE_DIR=data/knowledge_base
PROFILE_DIR=data/profiles
RESOURCE_DIR=data/resources
LOG_DIR=data/learning_logs
