# 构建阶段
FROM node:18-alpine AS builder

WORKDIR /app

# 复制前端代码
COPY edu-agent-web/package*.json ./
RUN npm install

COPY edu-agent-web/ .
RUN npm run build

# 运行阶段 - Nginx
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html
# 复制nginx配置
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]